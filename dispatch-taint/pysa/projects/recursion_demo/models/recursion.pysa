# Models for the (C) recursion/inter-procedural demonstration targets.
# fetch_page = attacker-influenceable tool output (SOURCE)
# call_model = the LLM node, modeled as TITO tagged llm_node (the §4.4 join)
# run_shell  = dangerous sink (SINK)
# append_message = the §4.3 history-append bridge, modeled as a propagator that
#                  updates the `history` argument with the appended msg's taint.

def value_threaded.fetch_page(url) -> TaintSource[ToolOutput, Via[cap_string]]: ...
def value_threaded.call_model(messages: TaintInTaintOut[Via[llm_node]]): ...
def value_threaded.run_shell(command: TaintSink[CodeExecution]): ...

def shared_list_direct.fetch_page(url) -> TaintSource[ToolOutput, Via[cap_string]]: ...
def shared_list_direct.call_model(messages: TaintInTaintOut[Via[llm_node]]): ...
def shared_list_direct.run_shell(command: TaintSink[CodeExecution]): ...
def shared_list_direct.append_message(history, msg: TaintInTaintOut[Updates[history]]): ...
