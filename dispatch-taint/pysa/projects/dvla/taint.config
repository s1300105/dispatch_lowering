{
  "sources": [
    { "name": "ToolOutput" }
  ],
  "sinks": [
    { "name": "CodeExecution" },
    { "name": "SQL" },
    { "name": "SSRF" },
    { "name": "FileSystem" },
    { "name": "Deserialization" }
  ],
  "features": [
    { "name": "llm_node" },
    { "name": "cap_bool" },
    { "name": "cap_enum" },
    { "name": "cap_string" },
    { "name": "role_readonly" },
    { "name": "role_exec" }
  ],
  "rules": [
    { "name": "Cross-tool flow to code execution", "code": 9001,
      "sources": ["ToolOutput"], "sinks": ["CodeExecution"],
      "message_format": "Tool output {$sources} reaches code-execution sink {$sinks}" },
    { "name": "Cross-tool flow to SQL", "code": 9002,
      "sources": ["ToolOutput"], "sinks": ["SQL"],
      "message_format": "Tool output {$sources} reaches SQL sink {$sinks}" },
    { "name": "Cross-tool flow to SSRF", "code": 9003,
      "sources": ["ToolOutput"], "sinks": ["SSRF"],
      "message_format": "Tool output {$sources} reaches outbound-request sink {$sinks}" },
    { "name": "Cross-tool flow to filesystem", "code": 9004,
      "sources": ["ToolOutput"], "sinks": ["FileSystem"],
      "message_format": "Tool output {$sources} reaches filesystem sink {$sinks}" },
    { "name": "Cross-tool flow to deserialization", "code": 9005,
      "sources": ["ToolOutput"], "sinks": ["Deserialization"],
      "message_format": "Tool output {$sources} reaches deserialization sink {$sinks}" }
  ]
}
