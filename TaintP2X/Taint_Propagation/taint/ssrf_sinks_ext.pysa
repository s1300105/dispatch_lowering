# ssrf_sinks_ext.pysa — SSRF sink coverage extension for TaintP2X
#
# 既存 http_server.pysa は requests.api.get / requests.api.request しか
# SSRFSink にしていない。狩り対象を取りこぼさないよう、主要な HTTP クライアントを追加する。
#
# 配置: TaintP2X/Taint_Propagation/taint/ssrf_sinks_ext.pysa として置く
#       (taint.config の taint_models_path 配下に入れる)。
# 注意: Pysa は「パラメータ名が実シグネチャと一致しないモデル」を黙って無視する。
#       導入後、pyre のログに "model ... not found / parameter ... " 警告が出ていないか確認すること。
#       下記は一般的なシグネチャに合わせてあるが、インストール版で名前が違う場合は調整する。

# ---------- requests: 他の verb + Session ----------
def requests.api.post(url: TaintSink[SSRFSink], data, json): ...
def requests.api.put(url: TaintSink[SSRFSink], data): ...
def requests.api.patch(url: TaintSink[SSRFSink], data): ...
def requests.api.delete(url: TaintSink[SSRFSink]): ...
def requests.api.head(url: TaintSink[SSRFSink]): ...
def requests.api.options(url: TaintSink[SSRFSink]): ...
def requests.sessions.Session.request(self, method, url: TaintSink[SSRFSink], params: TaintSink[SSRFSink]): ...
def requests.sessions.Session.get(self, url: TaintSink[SSRFSink]): ...
def requests.sessions.Session.post(self, url: TaintSink[SSRFSink], data, json): ...
def requests.sessions.Session.put(self, url: TaintSink[SSRFSink], data): ...
def requests.sessions.Session.patch(self, url: TaintSink[SSRFSink], data): ...
def requests.sessions.Session.delete(self, url: TaintSink[SSRFSink]): ...

# ---------- urllib (標準ライブラリ — 定番の SSRF sink) ----------
def urllib.request.urlopen(url: TaintSink[SSRFSink], data, timeout): ...
def urllib.request.Request.__init__(self, url: TaintSink[SSRFSink], data, headers, origin_req_host, unverifiable, method): ...

# ---------- httpx ----------
def httpx.get(url: TaintSink[SSRFSink], params): ...
def httpx.post(url: TaintSink[SSRFSink], content, data, json): ...
def httpx.put(url: TaintSink[SSRFSink], content, data, json): ...
def httpx.patch(url: TaintSink[SSRFSink], content, data, json): ...
def httpx.delete(url: TaintSink[SSRFSink]): ...
def httpx.head(url: TaintSink[SSRFSink]): ...
def httpx.request(method, url: TaintSink[SSRFSink], params): ...
def httpx.Client.get(self, url: TaintSink[SSRFSink], params): ...
def httpx.Client.post(self, url: TaintSink[SSRFSink], content, data, json): ...
def httpx.Client.request(self, method, url: TaintSink[SSRFSink], params): ...
def httpx.Client.build_request(self, method, url: TaintSink[SSRFSink], params): ...
def httpx.AsyncClient.get(self, url: TaintSink[SSRFSink], params): ...
def httpx.AsyncClient.post(self, url: TaintSink[SSRFSink], content, data, json): ...
def httpx.AsyncClient.request(self, method, url: TaintSink[SSRFSink], params): ...

# ---------- aiohttp ----------
def aiohttp.client.ClientSession.get(self, url: TaintSink[SSRFSink]): ...
def aiohttp.client.ClientSession.post(self, url: TaintSink[SSRFSink], data, json): ...
def aiohttp.client.ClientSession.put(self, url: TaintSink[SSRFSink], data): ...
def aiohttp.client.ClientSession.patch(self, url: TaintSink[SSRFSink], data): ...
def aiohttp.client.ClientSession.delete(self, url: TaintSink[SSRFSink]): ...
def aiohttp.client.ClientSession.request(self, method, url: TaintSink[SSRFSink]): ...
def aiohttp.client.ClientSession._request(self, method, str_or_url: TaintSink[SSRFSink]): ...

# ---------- urllib3 (requests/その他の下層。直接使う実装もある) ----------
def urllib3.poolmanager.PoolManager.request(self, method, url: TaintSink[SSRFSink]): ...
def urllib3.poolmanager.PoolManager.urlopen(self, method, url: TaintSink[SSRFSink]): ...
